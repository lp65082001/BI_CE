#system set

units		real
boundary	p p p
atom_style	angle
bond_style      harmonic
angle_style   harmonic
neigh_modify delay 0 every 1
pair_style lj/cut 20

read_data	2.data

# time integration settings
timestep		20	# 1fs
#thermo 2500
#thermosystem set
velocity 		all create 300.0 4928459 dist gaussian

compute bond all bond/local dist
compute angle all angle/local theta
#compute dihedral all dihedral/local phi 
#compute 1 all property/local btype batom1 batom2
#compute 1 all property/atom x y z

compute	d_bond all reduce ave c_bond
compute d_angle all reduce ave c_angle

compute myRDF all rdf 100 cutoff 10
fix 1 all ave/time 100 1 2500 c_myRDF[*] file rdf2.dump mode vector


dump 1 all local 2500 bond2.dump  index c_bond
dump 2 all local 2500 angle2.dump index c_angle   


fix				2 all nvt temp 300.0 300.0 200 

#run 25000















